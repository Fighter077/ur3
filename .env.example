# Kopiere nach .env und passe an. scripts/podman-up.sh liest diese Werte.
# Direkt setzen geht auch: ROBOT_MOCK=false ./scripts/podman-up.sh

# --- Roboter ---
# true = Simulation (keine Hardware), false = echter UR3e via RTDE
ROBOT_MOCK=true
# IP des UR3e im Netz (nur bei ROBOT_MOCK=false relevant)
ROBOT_IP=192.168.1.100

# --- Greifer (nur echter Roboter), siehe docs/REAL_ROBOT.md ---
# none = nur Statusflag | digital = UR-Digital-Ausgang | robotiq = Robotiq-2F via URCap
GRIPPER_TYPE=none
# GRIPPER_DO_PIN=0
# GRIPPER_DO_CLOSED=true

# --- Zyklus-Timing (ruhiger/schneller) ---
INSPECT_SETTLE_S=1.5     # Zeitfenster pro Seite (Label zeigen / Roboter still)
STEP_PAUSE_S=0.8         # Pause zwischen Schritten
INSPECT_FLIP_SPEED=0.30  # TCP-Geschwindigkeit front -> back [m/s], andere Fahrten unverändert
ROBOT_TCP_SPEED=0.20     # Normale TCP-Fahrten [m/s]
INSPECT_STILL_S=0.3     # Durchgehend am Ziel und still vor dem Aufhellen [s]
OCR_ATTEMPTS=4           # OCR-Versuche pro Seite (bestes Ergebnis zählt)

# --- Trigger-Geste (MediaPipe) ---
# Welche Hand-Geste startet den Inspektionszyklus: open | fist | point | pinch
TRIGGER_GESTURE=open
TRIGGER_STABLE_FRAMES=6

# --- OCR (Label lesen) ---
OCR_ENABLED=true
# Engine:
#   openai    -> Vision-LLM, liest UND wertet Marke/Spezifikation aus (zuverlaessigste Variante;
#                braucht Internet + OPENAI_API_KEY; Bild verlaesst den Rechner)
#   easyocr   -> lokal/offline, neuronal (grobe Felder)
#   tesseract -> lokal/offline, leicht
OCR_ENGINE=openai
OPENAI_API_KEY=            # NICHT committen (.env ist gitignored). gpt-4o-mini reicht meist.
OPENAI_MODEL=gpt-4o-mini  # fuer maximale Genauigkeit: gpt-4o
# Nur fuer easyocr/tesseract:
LABEL_CROP=true
OCR_MIN_CONF=0.3
# OCR_LANG=eng

# --- Optional: YOLO-Objekterkennung (z. B. "Teil im Halter?"), Standard aus ---
OBJECTS_ENABLED=false
YOLO_DEVICE=cpu

# --- Inspektion ---
# Gültige Bauteiltypen (eigener Halter-Insert je Typ)
PART_TYPES=HDD,optical,RAM
