# Kopiere nach .env und passe an. scripts/podman-up.sh liest diese Werte.
# Direkt setzen geht auch: ROBOT_MOCK=false ./scripts/podman-up.sh

# --- Roboter ---
# true = Simulation (keine Hardware), false = echter UR3e via RTDE
ROBOT_MOCK=true
# IP des UR3e im Netz (nur bei ROBOT_MOCK=false relevant)
ROBOT_IP=192.168.1.100

# --- Greifer (nur echter Roboter), siehe docs/REAL_ROBOT.md ---
# none = nur Statusflag | digital = UR-Digital-Ausgang | robotiq = Robotiq-2F via URCap
GRIPPER_TYPE=none
# GRIPPER_DO_PIN=0
# GRIPPER_DO_CLOSED=true

# --- Zyklus-Timing (ruhiger/schneller) ---
INSPECT_SETTLE_S=3.5     # Zeitfenster pro Seite (Label zeigen / Roboter still)
STEP_PAUSE_S=1.2         # Pause zwischen Schritten
OCR_ATTEMPTS=4           # OCR-Versuche pro Seite (bestes Ergebnis zählt)

# --- Trigger-Geste (MediaPipe) ---
# Welche Hand-Geste startet den Inspektionszyklus: open | fist | point | pinch
TRIGGER_GESTURE=open
TRIGGER_STABLE_FRAMES=6

# --- OCR (Label lesen) ---
OCR_ENABLED=true
OCR_LANG=eng

# --- Optional: YOLO-Objekterkennung (z. B. "Teil im Halter?"), Standard aus ---
OBJECTS_ENABLED=false
YOLO_DEVICE=cpu

# --- Inspektion ---
# Gültige Bauteiltypen (eigener Halter-Insert je Typ)
PART_TYPES=HDD,optical,RAM
