{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

http://127.0.0.1:8444 {
	bind 127.0.0.1
	respond /interface-url "https://{$CAMERA_HOST}:8443/"
}

https://{$CAMERA_HOST}:8443 {
	tls internal

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		reverse_proxy 127.0.0.1:4200 {
			header_up Host localhost:4200
		}
	}
}
